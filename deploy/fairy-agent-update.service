# /etc/systemd/system/fairy-agent-update.service  (Linux; only for self_update, see AGENT.md "Updates")
#
# Installs the Fairy-agent release that the agent downloaded and staged in /var/lib/fairy-agent/update when an
# admin pressed Update in the panel. Started by the agent (`systemctl start`, allowed by the polkit rule), never
# enabled and never on a timer. As root it:
#   - checks the staged SHA256SUMS signature again with the key built into the INSTALLED binary, then the
#     binary's hash, on the copy it makes next to /usr/local/bin/fairy-agent (the stage itself is not trusted);
#   - keeps the old binary as /usr/local/bin/fairy-agent.old, moves the new one in, runs restorecon (SELinux);
#   - restarts fairy-agent.service and waits up to ~40 s until it is active and proves that it runs the new
#     version (GET /health: the agent's token is never sent); otherwise it puts the old binary back and
#     restarts that. It refuses to run again within ten minutes of its last run.
# Its result goes to /var/lib/fairy-agent-update/result.json (the agent shows it to the panel) and the journal:
#   journalctl -u fairy-agent-update
[Unit]
Description=Fairy agent self-update (installs a verified, staged release)
Documentation=file:///usr/local/share/doc/fairy-agent/AGENT.md
# No [Install] section: never started at boot or by a dependency, only by an explicit `systemctl start`.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fairy-agent apply-update --config /etc/fairy-agent/config.yaml
TimeoutStartSec=300
StateDirectory=fairy-agent-update
StateDirectoryMode=0755
UMask=0022

# Runs as root (it replaces /usr/local/bin/fairy-agent and restarts a service), but sees a read-only system
# except /usr/local/bin and its own state folder.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/usr/local/bin
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# In an unprivileged LXC without nesting, namespace options can fail with status=226/NAMESPACE: then comment
# out PrivateTmp/PrivateDevices/Protect*/RestrictNamespaces (as for fairy-agent.service).
