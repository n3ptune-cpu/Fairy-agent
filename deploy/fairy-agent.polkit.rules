// /etc/polkit-1/rules.d/49-fairy-agent.rules
// Lets the fairy-agent user (and nobody else) do exactly two things through systemd. Each one is used only when
// it is switched on in /etc/fairy-agent/config.yaml (and in the panel).

// 1. power_control: power off, reboot or suspend (sleep) this machine through systemd-logind
// (`systemctl poweroff|reboot|suspend`). No hibernate, no ignoring inhibitors.
polkit.addRule(function (action, subject) {
    if (subject.user === "fairy-agent" && [
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.suspend",
        "org.freedesktop.login1.suspend-multiple-sessions"
    ].indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});

// 2. self_update: start the root installer unit fairy-agent-update.service (`systemctl start`), nothing else:
// no other unit, no stop/restart/enable. The installer checks the release signature itself before installing.
polkit.addRule(function (action, subject) {
    if (subject.user === "fairy-agent" && action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "fairy-agent-update.service" && action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
